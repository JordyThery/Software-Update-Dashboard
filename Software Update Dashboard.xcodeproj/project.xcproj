        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "K3LQ9NPBMG",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "15.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "be.jordythery.softwareupdatedashboard.uitests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "macosx",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TEST_TARGET_NAME": "Software Update Dashboard",
      },
    }, {
      "name": "Software Update Dashboard Tests",
      "id": "08B04A4930A1D8AD00A8222B",
      "product": "Products/Software Update Dashboard Tests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Software Update Dashboard",
      "dependencies": [
        "Software Update Dashboard",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
